      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh bìa"
          }
        }
      }
    },
    "Auto-connect to last device": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động kết nối với thiết bị sau cùng"
