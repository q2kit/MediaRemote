      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin"
          }
        }
      }
    },
    "Allow Local Network access for the app in Settings › Privacy & Security › Local Network.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép ứng dụng truy cập Mạng cục bộ trong Cài đặt › Quyền riêng tư & Bảo mật › Mạng cục bộ."
          }
        }
      }
    },
